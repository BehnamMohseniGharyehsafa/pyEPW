include LICENSE NOTICE CHANGELOG.md CONTRIBUTING.md
include CITATION.cff SECURITY.md CODE_OF_CONDUCT.md DATA_SOURCES.md
include open_meteo_epw.py requirements.txt
recursive-include .github *.yml
recursive-include docs *.md
recursive-include docs/assets *.svg *.png
recursive-include docs/data *.csv *.json *.md
recursive-include tools *.py
recursive-include examples *.py
recursive-include tests *.py
recursive-include validation *.py *.md *.txt
prune .verification
prune output
prune .openmeteo_cache
global-exclude __pycache__ *.py[cod]
